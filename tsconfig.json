{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/constants": [
        "./constants"
      ],
      "@/constants/*": [
        "./constants/*"
      ],
      "@/components": [
        "./components"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/assets": [
        "./assets"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@/styles": [
        "./styles"
      ],
      "@/styles/*": [
        "./styles/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
